# انسخ الملف ده لـ .env واملأ القيم
# .env مش بيترفع على git أبداً

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# true = التطبيق يشتغل بداتا وهمية من غير backend
VITE_USE_MOCK=false

# لو هتنشر على GitHub Pages تحت /repo-name
# VITE_BASE=/company-portal/
